<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news_shown = 3 %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% for item in news %}
          <tr
            {% if include.limit and forloop.index > news_shown %}
              class="news-extra" style="display: none"
            {% endif %}
          >
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if include.limit and news_size > news_shown %}
      <a
        href="#"
        class="news-toggle"
        onclick="var hidden = this.textContent.trim() == 'Show more'; document.querySelectorAll('.news-extra').forEach(function (row) { row.style.display = hidden ? '' : 'none'; }); this.textContent = hidden ? 'Show less' : 'Show more'; return false;"
      >
        Show more
      </a>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
